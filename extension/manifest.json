{
  "manifest_version": 3,
  "name": "Diecast Hunter — eBay",
  "version": "0.3.0",
  "description": "Shows the diecastregistry.com match and valuation for eBay diecast listings, via your Diecast Hunter desktop app.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://www.ebay.com/itm/*", "https://m.ebay.com/itm/*"],
      "js": ["panel-state.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "diecast-hunter@thistlegrow.com",
      "strict_min_version": "121.0"
    }
  }
}
